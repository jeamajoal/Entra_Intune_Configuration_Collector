{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Collector Offline Knowledge Catalog",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "catalogId": {
      "type": "string",
      "pattern": "^catalog-v1:.+$"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "runStatus": {
      "type": "string",
      "enum": ["Completed", "CompletedWithErrors"]
    },
    "sourceManifest": {
      "$ref": "#/$defs/sourceManifest"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    }
  },
  "required": [
    "schemaVersion",
    "catalogId",
    "runId",
    "runStatus",
    "sourceManifest",
    "artifacts",
    "dependencies",
    "relationships"
  ],
  "$defs": {
    "stage": {
      "type": "string",
      "enum": ["stage1", "stage2", "stage3"]
    },
    "section": {
      "type": "string",
      "enum": ["entra-apps", "entra-pim", "intune-core", "onprem-ad-gpo"]
    },
    "family": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "kind": {
      "type": "string",
      "enum": ["inventory", "detail", "relationship"]
    },
    "sourceManifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relativePath": {
          "type": "string",
          "const": "manifest/run-manifest.json"
        },
        "schemaVersion": {
          "type": "string",
          "enum": ["1.0", "1.1"]
        },
        "completedUtc": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["Completed", "CompletedWithErrors"]
        },
        "invocationCount": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["relativePath", "schemaVersion", "completedUtc", "status", "invocationCount"]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceType": {
          "type": "string",
          "minLength": 1
        },
        "sourceName": {
          "type": "string",
          "minLength": 1
        },
        "apiVersion": {
          "type": "string",
          "minLength": 1
        },
        "isBeta": {
          "type": "boolean"
        }
      },
      "required": ["sourceType", "sourceName", "apiVersion", "isBeta"]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "section": {
          "$ref": "#/$defs/section"
        },
        "family": {
          "$ref": "#/$defs/family"
        },
        "batchId": {
          "type": "string",
          "pattern": "^[0-9]{4,}$"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "relativePath": {
          "type": "string",
          "pattern": "^stage[123]/(entra-apps|entra-pim|intune-core|onprem-ad-gpo)/[A-Za-z0-9][A-Za-z0-9._-]*/batch-[0-9]{4,}\\.json$"
        },
        "checkpointRelativePath": {
          "type": "string",
          "pattern": "^checkpoints/stage[123]/(entra-apps|entra-pim|intune-core|onprem-ad-gpo)/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
        },
        "snapshotSchemaVersion": {
          "type": "string",
          "const": "1.0"
        },
        "checkpointSchemaVersion": {
          "type": "string",
          "const": "1.0"
        },
        "itemCount": {
          "type": "integer",
          "minimum": 0
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "required": [
        "runId",
        "stage",
        "section",
        "family",
        "batchId",
        "kind",
        "relativePath",
        "checkpointRelativePath",
        "snapshotSchemaVersion",
        "checkpointSchemaVersion",
        "itemCount",
        "provenance"
      ]
    },
    "dependencyEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "section": {
          "$ref": "#/$defs/section"
        },
        "family": {
          "$ref": "#/$defs/family"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        }
      },
      "required": ["stage", "section", "family", "kind"]
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dependencyType": {
          "type": "string",
          "enum": ["execution-input", "reference"]
        },
        "consumer": {
          "$ref": "#/$defs/dependencyEndpoint"
        },
        "provider": {
          "$ref": "#/$defs/dependencyEndpoint"
        }
      },
      "required": ["dependencyType", "consumer", "provider"]
    },
    "identityDomain": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stage": {
          "type": "string",
          "const": "stage3"
        },
        "section": {
          "$ref": "#/$defs/section"
        },
        "family": {
          "$ref": "#/$defs/family"
        },
        "relationshipType": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "sourceIdentityDomains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identityDomain"
          }
        },
        "targetIdentityDomains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identityDomain"
          }
        }
      },
      "required": [
        "stage",
        "section",
        "family",
        "relationshipType",
        "sourceIdentityDomains",
        "targetIdentityDomains"
      ]
    }
  }
}
