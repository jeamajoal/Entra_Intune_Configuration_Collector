{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Collector Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "stage": {
      "type": "string"
    },
    "section": {
      "type": "string"
    },
    "family": {
      "type": "string"
    },
    "updatedUtc": {
      "type": "string"
    },
    "plan": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "planVersion": { "type": "string" },
        "batchSize": { "type": "integer", "minimum": 1 },
        "expectedBatchCount": { "type": "integer", "minimum": 0 },
        "sourceFingerprint": { "type": "string" },
        "completed": { "type": "boolean" },
        "observation": { "$ref": "#/$defs/observation" },
        "batches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "batchId": { "type": "string" },
              "itemCount": { "type": "integer", "minimum": 0 },
              "fingerprint": { "type": "string" }
            },
            "required": ["batchId", "itemCount", "fingerprint"]
          }
        }
      },
      "required": ["planVersion", "batchSize", "expectedBatchCount", "sourceFingerprint", "completed", "batches"]
    },
    "batches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "batchId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Succeeded",
              "Failed",
              "InProgress",
              "Missing"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "itemCount": {
            "type": "integer",
            "minimum": 0
          },
          "successCount": {
            "type": "integer",
            "minimum": 0
          },
          "failedCount": {
            "type": "integer",
            "minimum": 0
          },
          "artifactPath": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "updatedUtc": {
            "type": "string"
          }
        },
        "required": [
          "batchId",
          "status",
          "attempts",
          "itemCount",
          "successCount",
          "failedCount",
          "updatedUtc"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "stage",
    "section",
    "family",
    "updatedUtc",
    "plan",
    "batches"
  ],
  "$defs": {
    "nullableString": {
      "type": ["string", "null"]
    },
    "providerAvailable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startUtc": {"$ref": "#/$defs/nullableString"},
        "endUtc": {"$ref": "#/$defs/nullableString"},
        "retentionCaveat": {"$ref": "#/$defs/nullableString"}
      },
      "required": ["startUtc", "endUtc", "retentionCaveat"]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {"type": "string", "const": "1.0"},
        "requested": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "startUtc": {"type": "string"},
            "endUtc": {"type": "string"}
          },
          "required": ["startUtc", "endUtc"]
        },
        "eventTimeProperty": {"$ref": "#/$defs/nullableString"},
        "providerAvailable": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/providerAvailable"}
          ]
        },
        "planIdentity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "required": ["schemaVersion", "requested", "eventTimeProperty", "providerAvailable", "planIdentity"]
    }
  }
}
