{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Collector Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string" },
    "runId": { "type": "string" },
    "startedUtc": { "type": "string" },
    "completedUtc": { "type": ["string", "null"] },
    "status": {
      "type": "string",
      "enum": ["InProgress", "Completed", "CompletedWithErrors", "Failed"]
    },
    "parameters": { "type": "object" },
    "stageResults": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "checkpointSummary": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stage": { "type": "string" },
          "section": { "type": "string" },
          "family": { "type": "string" },
          "error": { "type": "string" }
        },
        "required": ["stage", "section", "family", "error"]
      }
    },
    "invocations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "startedUtc": { "type": "string" },
          "completedUtc": { "type": ["string", "null"] },
          "status": {
            "type": "string",
            "enum": ["InProgress", "Completed", "CompletedWithErrors", "Failed"]
          },
          "parameters": { "type": "object" },
          "stageResults": {
            "type": "array",
            "items": { "type": "object", "additionalProperties": true }
          },
          "failures": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "stage": { "type": "string" },
                "section": { "type": "string" },
                "family": { "type": "string" },
                "error": { "type": "string" }
              },
              "required": ["stage", "section", "family", "error"]
            }
          }
        },
        "required": ["startedUtc", "completedUtc", "status", "parameters", "stageResults", "failures"]
      }
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "startedUtc",
    "completedUtc",
    "status",
    "parameters",
    "stageResults",
    "checkpointSummary",
    "failures",
    "invocations"
  ]
}
